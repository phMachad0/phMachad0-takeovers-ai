# .env.example - variable NAMES only, never values. Never commit a real .env.
#
# The deterministic pipeline (stages E0-E9) needs NO credentials at all: it reads the
# OCR that ships with the corpus. These variables are only read if the optional VLM
# escalation stage (E11) is enabled.

# Provider key for the vision-model escalation path. Unset => escalation is skipped.
ANTHROPIC_API_KEY=

# Model id used for escalation, e.g. claude-sonnet-5. Recorded in results.json -> run.model.
LIASSE_VLM_MODEL=

# Safety cap: max pages the escalation path may send in one run. Guards against
# a routing bug turning into an unexpected bill.
LIASSE_VLM_MAX_PAGES=

# Render resolution for page images sent to the VLM. Drives cost: token count grows
# with the square of this value. See wiki/02-conceitos/custo-por-pagina.md.
LIASSE_VLM_DPI=
