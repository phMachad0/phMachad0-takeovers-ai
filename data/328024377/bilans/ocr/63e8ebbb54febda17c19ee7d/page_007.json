              3096
            ],
            [
              2235,
              3104
            ],
            [
              2235,
              3146
            ],
            [
              197,
              3137
            ]
          ],
          "score": 0.9854283928871155,
          "text": "été fait une distinction entre les effets ponctuels et les effets structurels. Ces effets sont détaillés en tenant compte des interactions et"
        },
        {
          "orientation_angle": 0,
          "polygon": [
            [
              198,
              3146
            ],
            [
              2230,
              3156
            ],
            [
              2230,
              3198
            ],
            [
              197,
              3187
            ]
          ],
          "score": 0.9939290285110474,
          "text": "incidences de l'événement sur les agrégats usuels en appréciant les impacts bruts et nets. Les mesures de soutien dont elle a pu"
        },
        {
          "orientation_angle": 0,
          "polygon": [
            [
              198,
              3197
            ],
            [
              735,
              3199
            ],
            [
