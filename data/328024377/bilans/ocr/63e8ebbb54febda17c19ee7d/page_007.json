              2237,
              2697
            ],
            [
              2237,
              2737
            ],
            [
              199,
              2728
            ]
          ],
          "score": 0.9919639825820923,
          "text": "sa situation financière. Cette approche est recommandée par l'Autorité des Normes Comptables dans la note du 18 mai 2020 pour fournir"
        },
        {
          "orientation_angle": 0,
          "polygon": [
            [
              199,
              2738
            ],
            [
              1387,
              2744
            ],
            [
