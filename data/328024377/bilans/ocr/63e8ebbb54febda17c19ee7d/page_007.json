              3241
            ],
            [
              197,
              3239
            ]
          ],
          "score": 0.9946998357772827,
          "text": "bénéficier sont également évaluées."
        }
      ]
    },
    {
      "bbox": [
        200.13079833984375,
        683.135498046875,
        2234.526123046875,
        881.376708984375
      ],
      "label": "text",
      "score": 0.907976508140564,
      "texts": [
