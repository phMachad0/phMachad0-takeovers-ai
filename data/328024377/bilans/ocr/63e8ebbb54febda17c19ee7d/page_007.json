              2238,
              2687
            ],
            [
              199,
              2678
            ]
          ],
          "score": 0.9931429028511047,
          "text": "Pour cela, l'entreprise a retenu une approche ciblée pour exprimer les principaux impacts pertinents sur la performance de l'exercice et sur"
        },
        {
          "orientation_angle": 0,
          "polygon": [
